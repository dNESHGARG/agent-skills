          "invariant": "Balance cannot become negative"
        }
      ],
      "false_positive_traps": [
        "Claiming actor isolation prevents reentrancy"
      ]
    },
    {
      "id": "cache-key",
      "file": "fixtures/cache-key.py",
      "skills": [
        "code-review",
        "bug-investigation"
      ],
      "expected": [
        {
          "id": "cache-key-collision",

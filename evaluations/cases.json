{
  "version": 1,
  "cases": [
    {
      "id": "stale-search",
      "file": "stale-search.ts",
      "skills": [
        "bug-investigation",
        "concurrency-audit",
        "code-review"
      ],
      "expected": [
        {
          "id": "stale-result",
          "severity": "P2",
          "trigger": "Two overlapping searches resolve out of order",
          "invariant": "UI reflects latest query"
        }
      ],
      "false_positive_traps": [
        "Calling this a multithreaded memory race"
      ]
    },
    {
      "id": "duplicate-charge",
      "file": "fixtures/duplicate-charge.ts",
      "skills": [
        "code-review"
      ],
      "expected": [
        {
          "id": "non-idempotent-charge",
          "severity": "P1",
          "trigger": "Two identical concurrent payment submissions",
          "invariant": "One logical checkout creates at most one charge"
        }
      ],
      "false_positive_traps": [
        "Claiming a client-only loading flag guarantees exactly-once charging"
      ]
    },
    {
      "id": "actor-reentrancy",
      "file": "fixtures/actor-reentrancy.swift",
      "skills": [
        "swift-concurrency-review",
